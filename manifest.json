{
  "manifest_version": 3,
  "name": "Claude Exporter",
  "version": "0.8.0",
  "description": "Export Claude chats, artifacts, projects, skills and memory to Markdown/PDF on your computer. Everything runs locally.",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content/api-client.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-exporter@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
